#!/bin/sh
### BEGIN INIT INFO
# Provides:          dnsadmin
# Required-Start:    $network $local_fs $remote_fs
# Required-Stop:     $network $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Gunicorn daemon for pdnsadmin-z
### END INIT INFO

APP_DIR="/var/www/pdnsadmin-z"
USER="www-data"
PIDFILE="/run/dnsadmin/dnsadmin.pid"
CERTFILE="/var/www/pdnsadmin-z/cert.pem"
KEYFILE="/var/www/pdnsadmin-z/privkey.pem"
LOGFILE="/var/log/dnsadmin-gunicorn.log"
ERRFILE="/var/log/dnsadmin-gunicorn.err"
DAEMON="$(command -v gunicorn 2>/dev/null)"
[ -z "$DAEMON" ] && DAEMON="/usr/bin/gunicorn"


# Para Nginx delante:
BIND_ADDR="0.0.0.0:5000"

# Export de config
ENV_VARS="DNSADMIN_CONFIG=$APP_DIR/config.ini"

# Gunicorn opts:
# - Sin --daemon (lo maneja start-stop-daemon)
# - --access-logfile / --error-logfile para dejar rastros
#DAEMON_OPTS="--workers 3 --bind $BIND_ADDR --pid $PIDFILE \
#  --access-logfile $LOGFILE --error-logfile $ERRFILE --log-level debug \
#  wsgi:app"

DAEMON_OPTS="--workers 3 \
  --bind $BIND_ADDR \
  --pid $PIDFILE \
  --certfile $CERTFILE \
  --keyfile $KEYFILE \
  --access-logfile $LOGFILE \
  --error-logfile $ERRFILE \
  --log-level \
  wsgi:app"


# Asegura permisos de logs
ensure_logs() {
  touch "$LOGFILE" "$ERRFILE" 2>/dev/null
  chown "$USER":"$USER" "$LOGFILE" "$ERRFILE" 2>/dev/null
  chmod 0640 "$LOGFILE" "$ERRFILE" 2>/dev/null
}

do_start() {
  echo "Iniciando pdnsadmin-z (Gunicorn) en $BIND_ADDR..."
  ensure_logs

  # Si ya corre, no duplicar
  if [ -f "$PIDFILE" ] && ps -p "$(cat "$PIDFILE" 2>/dev/null)" >/dev/null 2>&1; then
    echo "Ya está activo (PID $(cat "$PIDFILE"))."
    return 0
  fi

  # start-stop-daemon es lo más robusto en init.d
  # --chdir garantiza rutas relativas (si wsgi/certs etc)
  # --make-pidfile crea pidfile si no existe
  start-stop-daemon --start --background \
    --chuid "$USER" --chdir "$APP_DIR" \
    --make-pidfile --pidfile "$PIDFILE" \
    --startas /bin/sh -- -c "export $ENV_VARS; exec '$DAEMON' $DAEMON_OPTS" \
    >>"$LOGFILE" 2>>"$ERRFILE"

  RC=$?
  if [ $RC -ne 0 ]; then
    echo "Fallo al iniciar (rc=$RC). Mirá $ERRFILE"
    return $RC
  fi

  sleep 1
  if [ -f "$PIDFILE" ] && ps -p "$(cat "$PIDFILE" 2>/dev/null)" >/dev/null 2>&1; then
    echo "Activo (PID $(cat "$PIDFILE"))."
    return 0
  fi

  echo "No quedó activo. Revisá:"
  echo "  - $ERRFILE"
  echo "  - $LOGFILE"
  return 1
}

do_stop() {
  echo "Deteniendo pdnsadmin-z (Gunicorn)..."
  if [ -f "$PIDFILE" ]; then
    start-stop-daemon --stop --pidfile "$PIDFILE" --retry 5/TERM/10/KILL
    RC=$?
    rm -f "$PIDFILE"
    return $RC
  else
    echo "PID file no encontrado. ¿Ya estaba detenido?"
    return 0
  fi
}

do_status() {
  if [ -f "$PIDFILE" ]; then
    PID="$(cat "$PIDFILE" 2>/dev/null)"
    if [ -n "$PID" ] && ps -p "$PID" >/dev/null 2>&1; then
      echo "pdnsadmin-z está activo (PID $PID)"
      return 0
    else
      echo "pdnsadmin-z NO está activo, pero quedó el pidfile."
      return 1
    fi
  else
    echo "pdnsadmin-z se encuentra DETENIDO."
    return 3
  fi
}

do_debug() {
  echo "DEBUG: ejecutando en primer plano (Ctrl+C para cortar)..."
  ensure_logs

  # corre sin background para ver el error ya
  # y también registra en archivos
  runuser -u "$USER" -- sh -c "cd '$APP_DIR' && export $ENV_VARS; exec '$DAEMON' $DAEMON_OPTS" \
    1>>"$LOGFILE" 2>>"$ERRFILE"
}

case "$1" in
  start)   do_start ;;
  stop)    do_stop ;;
  restart) do_stop; sleep 1; do_start ;;
  status)  do_status ;;
  debug)   do_debug ;;
  tail)
    echo "Mostrando últimos logs:"
    tail -n 80 "$ERRFILE" "$LOGFILE"
    ;;
  *)
    echo "Uso: /etc/init.d/dnsadmin {start|stop|restart|status|debug|tail}"
    exit 1
    ;;
esac

exit $?
