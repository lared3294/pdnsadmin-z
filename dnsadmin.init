#!/bin/sh
### BEGIN INIT INFO
# Provides:          dnsadmin
# Required-Start:    $network $local_fs $remote_fs
# Required-Stop:     $network $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Gunicorn daemon for pdnsadmin-z
### END INIT INFO

# Cambia estos valores según tu entorno
APP_DIR="/home/fpieri/sync-fernando/work/pdnsadmin-z"
# El binario de gunicorn puede variar según dónde esté instalado
# (ej: /usr/local/bin/gunicorn, /usr/bin/gunicorn o ~/.local/bin/gunicorn)
DAEMON="$(which gunicorn)"
if [ -z "$DAEMON" ]; then
    DAEMON="/usr/local/bin/gunicorn"
fi

PIDFILE="$APP_DIR/dnsadmin.pid"
# Usuario con el que se ejecutará la aplicación por seguridad (root puede ser peligroso)
USER="www-data"

# Opciones para gunicorn: el flag --daemon lo envía al fondo, y --pid guarda el id de proceso
DAEMON_OPTS="--workers 3 --bind 0.0.0.0:443 --certfile cert.pem --keyfile privkey.pem --pid $PIDFILE --daemon wsgi:app"

case "$1" in
  start)
    echo "Iniciando pdnsadmin-z (Gunicorn)..."
    export DNSADMIN_CONFIG="$APP_DIR/config.ini"

    # Cambiamos al usuario y ejecutamos el daemon dentro de su directorio
    su - -c "cd $APP_DIR && export DNSADMIN_CONFIG='$APP_DIR/config.ini' && $DAEMON $DAEMON_OPTS" "$USER"
    ;;
  stop)
    echo "Deteniendo pdnsadmin-z (Gunicorn)..."
    if [ -f "$PIDFILE" ]; then
        kill $(cat "$PIDFILE")
        rm -f "$PIDFILE"
    else
        echo "PID file no encontrado. ¿El proceso ya estaba detenido?"
    fi
    ;;
  restart)
    $0 stop
    sleep 2
    $0 start
    ;;
  status)
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        # Chequea sin arrojar salida si el proceso existe
        if ps -p $PID > /dev/null 2>&1; then
            echo "pdnsadmin-z está activo (PID $PID)"
        else
            echo "pdnsadmin-z NO está activo, pero quedó estancado el pidfile."
        fi
    else
        echo "pdnsadmin-z se encuentra DETENIDO."
    fi
    ;;
  *)
    echo "Uso: /etc/init.d/dnsadmin {start|stop|restart|status}"
    exit 1
    ;;
esac

exit 0
