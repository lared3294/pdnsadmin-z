#!/bin/sh
# Installed root-owned; SSH aliases and credentials belong to root.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

[ "$#" -eq 2 ] || { echo 'Uso: pdnsadmin-update-recursors recursor1|recursor2|recursor3|recursor4 hosts|forward-zones' >&2; exit 1; }
case "$1" in recursor1|recursor2|recursor3|recursor4) target=$1 ;; *) echo 'Destino desconocido' >&2; exit 1 ;; esac
case "$2" in hosts|forward-zones) file=$2 ;; *) echo 'Archivo desconocido' >&2; exit 1 ;; esac

umask 077
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
trap 'exit 1' HUP INT TERM
cat > "$work/payload"
# The entire transaction must arrive before execution: sh -s would otherwise
# execute a truncated stream after SSH disconnects. Base64 keeps data out of code.
{
    cat <<'REMOTE'
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077
file=$1
case "$file" in hosts|forward-zones) ;; *) exit 1 ;; esac
for command in flock mktemp base64 sha256sum timeout pdns_recursor rec_control; do
    command -v "$command" >/dev/null || { echo "Falta dependencia remota: $command" >&2; exit 1; }
done
config_dir=/etc/powerdns
destination=$config_dir/$file
[ -d "$config_dir" ] && [ ! -L "$config_dir" ] || exit 1
exec 9> "$config_dir/.pdnsadmin-deploy.lock"
flock -n 9 || { echo 'Ya hay un despliegue remoto en curso.' >&2; exit 1; }
[ ! -L "$destination" ] && { [ ! -e "$destination" ] || [ -f "$destination" ]; } || {
    echo 'El destino debe ser un archivo normal, no un enlace.' >&2; exit 1;
}
backup_dir=$config_dir/.pdnsadmin-backups
[ ! -L "$backup_dir" ] || exit 1
mkdir -p "$backup_dir"
chmod 700 "$backup_dir"
[ ! -d "$backup_dir/$file.previous" ] || exit 1
stage=$(mktemp -d "$config_dir/.pdnsadmin-stage.XXXXXXXX")
installed=0
committed=0
had_previous=0
restart() {
    if [ -d /run/systemd/system ]; then
        timeout 45 systemctl restart pdns-recursor 9>&-
    else
        timeout 45 service pdns-recursor restart 9>&-
    fi
}
healthy() {
    attempt=0
    while [ "$attempt" -lt 10 ]; do
        if timeout 3 rec_control --config-dir="$config_dir" --timeout=2 ping >/dev/null 2>&1; then
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done
    return 1
}
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ "$installed" -eq 1 ] && [ "$committed" -eq 0 ]; then
        echo 'Despliegue fallido; restaurando el archivo anterior.' >&2
        if [ "$had_previous" -eq 1 ]; then
            if ! mv -f "$stage/previous" "$destination"; then
                echo "ERROR: no se pudo restaurar; respaldo conservado en $stage/previous" >&2
                exit 1
            fi
        else
            rm -f "$destination" || { echo "ERROR: no se pudo retirar $destination" >&2; exit 1; }
        fi
        if restart && healthy; then
            echo 'Configuración anterior restaurada y recursor recuperado.' >&2
        else
            echo 'ERROR: archivo anterior restaurado, pero no se pudo recuperar el servicio. Requiere intervención.' >&2
        fi
        status=1
    fi
    rm -rf -- "$stage"
    exit "$status"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
base64 -d > "$stage/incoming" <<'PDNSADMIN_PAYLOAD'
REMOTE
    base64 "$work/payload"
    cat <<'REMOTE'
PDNSADMIN_PAYLOAD
REMOTE
    printf "expected='%s'\n" "$(sha256sum "$work/payload" | cut -d ' ' -f 1)"
    cat <<'REMOTE'
actual=$(sha256sum "$stage/incoming" | cut -d ' ' -f 1)
[ "$actual" = "$expected" ] || { echo 'Archivo incompleto o alterado; no se modifica el destino.' >&2; exit 1; }
# Accept only the normalized format emitted by the application, never shell code.
if [ "$file" = hosts ]; then
    awk 'NF != 2 || $1 != "0.0.0.0" || $2 !~ /^[a-z0-9_][a-z0-9_.-]*$/ {exit 1}' "$stage/incoming" || {
        echo 'Formato hosts inválido.' >&2; exit 1;
    }
    option=etc-hosts-file
else
    awk 'NF != 1 || $0 !~ /^[+^]*[a-z0-9_.-]+=[0-9a-fA-F:.,\[\]]+$/ {exit 1}' "$stage/incoming" || {
        echo 'Formato forward-zones inválido.' >&2; exit 1;
    }
    option=forward-zones-file
fi
# This checks the configuration/options; loading auxiliary files is finally
# verified by restarting the installed version and checking its control socket.
timeout 20 pdns_recursor --config=check "--$option=$stage/incoming" "--config-dir=$config_dir" || {
    echo 'La comprobación de configuración falló; archivo activo intacto.' >&2; exit 1;
}
healthy || { echo 'El recursor no responde antes del despliegue; no se modifica.' >&2; exit 1; }
if [ -e "$destination" ]; then
    cp -p "$destination" "$stage/previous"
    had_previous=1
    cp -p "$destination" "$stage/candidate"
    cat "$stage/incoming" > "$stage/candidate"
else
    cp "$stage/incoming" "$stage/candidate"
    chmod 644 "$stage/candidate"
fi
# Mark first so a signal immediately after rename also triggers restoration.
installed=1
mv -f "$stage/candidate" "$destination"
if ! restart || ! healthy; then
    echo 'El recursor no arrancó o no responde con el archivo nuevo.' >&2
    exit 1
fi
if [ "$had_previous" -eq 1 ]; then
    cp -p "$stage/previous" "$stage/retained-backup"
    mv -f "$stage/retained-backup" "$backup_dir/$file.previous"
fi
committed=1
printf '%s instalado; recursor reiniciado y responde.\n' "$file"
REMOTE
} > "$work/transaction"
# Upload to a private remote temporary file first, then execute only after EOF
# and a matching checksum. This avoids executing an incomplete shell program.
digest=$(sha256sum "$work/transaction" | cut -d ' ' -f 1)
ssh -T -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10 \
    -o ServerAliveInterval=15 -o ServerAliveCountMax=2 "$target" \
    "umask 077; transaction=\$(mktemp) || exit 1; trap 'rm -f \"\$transaction\"' EXIT HUP INT TERM; cat > \"\$transaction\" && echo '$digest  '\"\$transaction\" | sha256sum -c - >/dev/null && sh \"\$transaction\" '$file'" \
    < "$work/transaction"
printf '%s: %s aplicado y comprobado.\n' "$target" "$file"
