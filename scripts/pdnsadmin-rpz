#!/usr/bin/env python3
"""Root-owned SSH helper installed once on each recursive server."""
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
import time

CONFIG = Path('/etc/pdnsadmin-rpz.json')
MAX_BYTES = 48 * 1024 * 1024


def load_config(path=CONFIG):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError('La configuración del helper debe ser un archivo de root sin escritura de grupo/otros.')
    config = json.loads(path.read_text())
    for key in ('policy_file', 'lua_file'):
        value = config[key]
        if not isinstance(value, str) or not value.startswith('/') or not re.fullmatch(r'/[a-zA-Z0-9_./-]+', value):
            raise ValueError(f'Ruta inválida: {key}')
    if not re.fullmatch(r'[a-zA-Z0-9_-]+', config['service']):
        raise ValueError('Nombre de servicio inválido.')
    mode = config.get('init_system', 'auto')
    if mode == 'auto':
        mode = 'systemd' if Path('/run/systemd/system').is_dir() else 'sysv'
    if mode not in ('systemd', 'sysv'):
        raise ValueError('init_system debe ser auto, systemd o sysv.')
    config['init_system'] = mode
    args = config.get('control_args', [])
    if not isinstance(args, list) or any(not isinstance(arg, str) for arg in args):
        raise ValueError('control_args debe ser una lista de argumentos para rec_control.')
    config['control_args'] = args
    return config


def service_command(config, action):
    if config['init_system'] == 'systemd':
        if action == 'status':
            return ['/usr/bin/systemctl', 'is-active', '--quiet', config['service']]
        return ['/usr/bin/systemctl', action, config['service']]
    return ['/usr/sbin/service', config['service'], action]


def run_service(config, action):
    return subprocess.run(service_command(config, action), capture_output=True,
                          text=True, timeout=45 if action == 'restart' else 5, check=False).returncode == 0


def wait_active(config):
    end = time.monotonic() + 10
    while time.monotonic() < end:
        if run_service(config, 'status'):
            return True
        time.sleep(.5)
    return False


def check_ready(config):
    policy = Path(config['policy_file'])
    if policy.is_symlink() or not policy.is_file():
        raise ValueError('Falta la política inicial o es un enlace simbólico.')
    lua = Path(config['lua_file']).read_text()
    lua = '\n'.join(line.split('--', 1)[0] for line in lua.splitlines())
    pattern = r'rpzFile\s*\(\s*([\'\"])' + re.escape(config['policy_file']) + r'\1'
    if not re.search(pattern, lua):
        raise ValueError('El archivo Lua no declara rpzFile para esta política. Configura primero Recursor.')
    if not run_service(config, 'status'):
        raise ValueError('El servicio recursivo no está activo; no se sustituye la política.')
    # Verify that the running recursor actually uses the declared Lua file.
    active = False
    for key in ('lua-config-file', 'recursor.lua_config_file'):
        result = subprocess.run(['/usr/bin/rec_control', *config.get('control_args', []),
                                 'get-parameter', key], capture_output=True, text=True, timeout=5, check=False)
        path_pattern = r'(?<![a-zA-Z0-9_./-])' + re.escape(config['lua_file']) + r'(?![a-zA-Z0-9_./-])'
        if result.returncode == 0 and re.search(path_pattern, result.stdout):
            active = True
            break
    if not active:
        raise ValueError('Recursor no confirma el Lua activo. Revisa lua-config-file y control_args.')


def validate_policy(text):
    if not isinstance(text, str) or len(text.encode()) > MAX_BYTES:
        raise ValueError('Política demasiado grande o inválida.')
    lines = text.splitlines()
    if len(lines) < 4 or lines[:2] != ['$ORIGIN pdnsadmin.rpz.', '$TTL 60']:
        raise ValueError('Cabecera RPZ inválida.')
    if not re.fullmatch(r'@ IN SOA localhost\. hostmaster\.localhost\. [0-9]{1,10} 60 60 604800 60', lines[2]) or lines[3] != '@ IN NS localhost.':
        raise ValueError('SOA/NS inválidos.')
    names = set()
    for line in lines[4:]:
        match = re.fullmatch(r'([a-z0-9_.-]+) CNAME \.', line)
        if not match:
            raise ValueError('La política solo admite reglas NXDOMAIN de nombres exactos.')
        name = match[1]
        if (len(name + '.pdnsadmin.rpz') > 253 or len(name.split('.')) < 2
                or any(not re.fullmatch(r'[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9_])?', label) for label in name.split('.'))
                or name in names):
            raise ValueError('Dominio inválido o duplicado en la política.')
        names.add(name)
    return len(names)


def atomic_write(path, content, info):
    fd, temp = tempfile.mkstemp(prefix='.pdnsadmin-rpz-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            os.fchmod(stream.fileno(), stat.S_IMODE(info.st_mode))
            os.fchown(stream.fileno(), info.st_uid, info.st_gid)
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def apply_policy(config, text):
    count = validate_policy(text)
    policy = Path(config['policy_file'])
    with open(str(policy) + '.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        check_ready(config)
        old, info = policy.read_text(), policy.stat()
        atomic_write(policy.with_name(policy.name + '.previous'), old, info)
        atomic_write(policy, text, info)
        try:
            if not run_service(config, 'restart') or not wait_active(config):
                raise RuntimeError('El reinicio con la nueva política falló.')
        except Exception as error:
            atomic_write(policy, old, info)
            try:
                restored = run_service(config, 'restart') and wait_active(config)
            except Exception:
                restored = False
            message = 'Política anterior restaurada y servicio activo.' if restored else 'Política anterior restaurada; revisa el servicio manualmente.'
            raise RuntimeError(f'{error} {message}') from error
    return count


def main():
    if os.geteuid() != 0:
        raise ValueError('El helper debe ejecutarse mediante sudo.')
    if sys.argv[1:] not in (['--check'], ['--apply']):
        raise ValueError('Uso: pdnsadmin-rpz --check|--apply')
    config = load_config()
    if sys.argv[1] == '--check':
        check_ready(config)
        print('SSH, permisos, declaración RPZ y servicio activo comprobados.')
    else:
        raw = sys.stdin.buffer.read(MAX_BYTES + 1)
        if len(raw) > MAX_BYTES:
            raise ValueError('Entrada demasiado grande.')
        payload = json.loads(raw)
        if not isinstance(payload, dict) or set(payload) != {'rpz'}:
            raise ValueError('Se esperaba únicamente el campo rpz.')
        count = apply_policy(config, payload['rpz'])
        print(f'Política aplicada: {count} dominios. Servicio reiniciado y activo.')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
